# ==============================================================================
# TrackIntake Frontend Environment Variables
# Duplicate this file as .env and fill in your actual configurations.
# ==============================================================================

# Backend REST API endpoint base URL
VITE_API_URL=http://127.0.0.1:7000/api

# Backend WebSocket URL
VITE_WS_URL=ws://127.0.0.1:7000

# Google Gemini API Key (Client-side AI assistant features)
# Generate key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_gemini_api_key_here
